[gd_scene load_steps=10 format=3]

; Converted from the Godot 3 (format=2) scene this project was ported from, and
; retuned for its new job.
;
; Every particle property here used to carry a Godot 3 name -- initial_velocity,
; scale_amount, angular_velocity, linear_accel, hue_variation -- none of which
; exist on Godot 4's CPUParticles2D. They were loaded and silently dropped, so
; the "explosion" was really eight full-size rocks released at zero velocity
; that fell straight down: the burst had not actually been visible since the
; port. The Godot 4 spellings (..._min/..._max) are used below.
;
; The corpse (actors/Corpse.gd) and its gibs now carry the impact of a death, so
; this is deliberately tuned DOWN from the numbers the Godot 3 scene asked for
; (600 px/s, full-size rocks) into a supporting burst of debris around the body,
; plus the explosion sound -- which is the part of this effect that always
; worked.

[ext_resource type="Texture2D" path="res://assets/kenney-platform-deluxe/request/rockSmall.png" id="1"]
[ext_resource type="Script" path="res://actors/ExplodeEffect.gd" id="2"]
[ext_resource type="Gradient" path="res://actors/ExplodeEffectGradient.tres" id="3"]
[ext_resource type="AudioStream" path="res://assets/sounds/explosions/explosion3.wav" id="4"]
[ext_resource type="Script" path="res://components/Sounds.gd" id="5"]
[ext_resource type="AudioStream" path="res://assets/sounds/explosions/explosion2.wav" id="6"]
[ext_resource type="AudioStream" path="res://assets/sounds/explosions/explosion1.wav" id="7"]

[sub_resource type="Curve" id="1"]
_data = [Vector2(0, 1), 0.0, 0.0, 0, 0, Vector2(1, 0.05), 0.0, 0.0, 0, 0]
point_count = 2

[node name="ExplodeEffect" type="CPUParticles2D"]
emitting = false
amount = 14
lifetime = 0.9
one_shot = true
explosiveness = 1.0
texture = ExtResource("1")
emission_shape = 2
emission_rect_extents = Vector2(10, 1)
direction = Vector2(0, -1)
spread = 70.0
gravity = Vector2(0, 1200)
initial_velocity_min = 110.0
initial_velocity_max = 330.0
angular_velocity_min = -220.0
angular_velocity_max = 220.0
linear_accel_min = 0.0
linear_accel_max = 50.0
damping_min = 10.0
damping_max = 40.0
scale_amount_min = 0.35
scale_amount_max = 0.75
scale_amount_curve = SubResource("1")
color_ramp = ExtResource("3")
hue_variation_min = -0.05
hue_variation_max = 0.05
script = ExtResource("2")

[node name="Timer" type="Timer" parent="."]
wait_time = 1.5
one_shot = true
autostart = true

[node name="Sounds" type="Node" parent="."]
script = ExtResource("5")

[node name="Explode" type="Node" parent="Sounds"]

[node name="Explode1" type="AudioStreamPlayer" parent="Sounds/Explode"]
stream = ExtResource("7")
bus = "Sound Effects"

[node name="Explode2" type="AudioStreamPlayer" parent="Sounds/Explode"]
stream = ExtResource("6")
bus = "Sound Effects"

[node name="Explode3" type="AudioStreamPlayer" parent="Sounds/Explode"]
stream = ExtResource("4")
bus = "Sound Effects"

[connection signal="timeout" from="Timer" to="." method="_on_Timer_timeout"]
