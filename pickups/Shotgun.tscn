[gd_scene load_steps=4 format=3]

; Inherits res://pickups/Gun.tscn: same barrel, same CooldownTimer, same
; "Shoot" animation with the method track that calls _fire_projectile(). Only
; the script, the tuning resource and the look differ -- the firing flow is
; Gun.gd's, reused rather than copied.

