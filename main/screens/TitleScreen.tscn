[node name="SecondaryButtons" type="HBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -130.0
offset_top = 206.0
offset_right = 130.0
offset_bottom = 236.0
grow_horizontal = 2
theme_override_constants/separation = 16
alignment = 1

[node name="SettingsButton" type="Button" parent="SecondaryButtons"]
custom_minimum_size = Vector2(122, 30)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Settings"

[node name="CreditsButton" type="Button" parent="SecondaryButtons"]
custom_minimum_size = Vector2(122, 30)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "Credits"

[node name="Hint" type="Label" parent="."]
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -280.0
offset_top = 330
offset_right = 280.0
offset_bottom = 348
grow_horizontal = 2
theme_override_colors/font_color = Color(0.435, 0.573, 0.643, 1)
theme_override_font_sizes/font_size = 15
text = "LOCAL: WASD + C/V  vs  Arrows + L/;      ONLINE: host a room, share the code"
horizontal_alignment = 1
vertical_alignment = 1


[connection signal="pressed" from="PrimaryButtons/LocalButton" to="." method="_on_LocalButton_pressed"]
[connection signal="pressed" from="PrimaryButtons/OnlineButton" to="." method="_on_OnlineButton_pressed"]
[connection signal="pressed" from="SecondaryButtons/SettingsButton" to="." method="_on_SettingsButton_pressed"]
[connection signal="pressed" from="SecondaryButtons/CreditsButton" to="." method="_on_CreditsButton_pressed"]
